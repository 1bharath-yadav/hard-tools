#!/data/data/com.termux/files/usr/bin/bash
#
# hard-tools: bluetooth/bt-profiles
# Android Bluetooth Profiles & Subsystem State Inspector
#

set -e

C_RESET="\033[0m"
C_BOLD="\033[1m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_CYAN="\033[1;36m"
C_MAGENTA="\033[1;35m"
C_DIM="\033[2m"

run_root() {
    if [[ $EUID -eq 0 ]]; then
        "$@"
    elif command -v su >/dev/null 2>&1; then
        su -c "$*"
    else
        "$@"
    fi
}

DUMP=$(run_root "dumpsys bluetooth_manager" 2>/dev/null || true)
if [[ -z "$DUMP" ]]; then
    echo -e "\033[1;31m[!] Error: Unable to query dumpsys bluetooth_manager. Root required.\033[0m" >&2
    exit 1
fi

echo -e "${C_CYAN}====================================================${C_RESET}"
echo -e "${C_BOLD} Android Bluetooth Profiles & Subsystems${C_RESET}"
echo -e "${C_CYAN}====================================================${C_RESET}"

echo -e "${C_MAGENTA}[ Registered Profile Services ]${C_RESET}"
echo "$DUMP" | awk '
/^Enabled Profile Services:/ { in_prof=1; next }
/^[A-Z][a-zA-Z0-9 ]+:/ && in_prof { in_prof=0 }
in_prof && /^[ ]+[A-Z0-9_]+/ {
  gsub(/^[ ]+/, "");
  if (NF > 0) {
    printf "  \033[1;32m✓\033[0m %-20s (Active in BluetoothManager)\n", $0
  }
}
'
echo

echo -e "${C_MAGENTA}[ Profile Subsystem Runtime States ]${C_RESET}"

# A2DP
A2DP_SRC=$(echo "$DUMP" | awk '/^A2DP Source State:/ { sub(/^A2DP Source State: */, ""); print; exit }')
A2DP_SNK=$(echo "$DUMP" | awk '/^A2DP Sink State:/ { sub(/^A2DP Sink State: */, ""); print; exit }')
A2DP_PEER=$(echo "$DUMP" | awk '/^  Source: active peer:/ { sub(/^  Source: active peer: */, ""); print; exit }')
printf "  ${C_BOLD}%-22s${C_RESET} : Source: %s | Sink: %s | Active Peer: %s\n" "A2DP (Audio Stream)" "${A2DP_SRC:-Unknown}" "${A2DP_SNK:-Unknown}" "${A2DP_PEER:-None}"

# HID Host
HID_STATUS=$(echo "$DUMP" | awk '/shim::legacy::hid status:/ { match($0, /status:[^ ]+/); print substr($0, RSTART+7, RLENGTH-7); exit }')
HID_DEV_CNT=$(echo "$DUMP" | awk '/shim::legacy::hid status:.*num_devices:/ { match($0, /num_devices:[0-9]+/); print substr($0, RSTART+12, RLENGTH-12); exit }')
printf "  ${C_BOLD}%-22s${C_RESET} : Status: %s | Connected HID: %s\n" "HID Host (KB/Mouse)" "${HID_STATUS:-IDLE}" "${HID_DEV_CNT:-0}"

# PAN
PAN_CONN=$(echo "$DUMP" | awk '/shim::legacy::pan Connections:/ { match($0, /Connections:[0-9]+/); print substr($0, RSTART+12, RLENGTH-12); exit }')
printf "  ${C_BOLD}%-22s${C_RESET} : Active Connections: %s | Interface: bt-pan\n" "PAN (Personal Net)" "${PAN_CONN:-0}"

# AVRCP
AVRCP_STATE=$(echo "$DUMP" | awk '/^AVRCP Native State:/ { in_avrcp=1; next } in_avrcp && /Devices/ { print $0; exit }')
printf "  ${C_BOLD}%-22s${C_RESET} : %s\n" "AVRCP (Media Control)" "${AVRCP_STATE:-Not active}"

# GATT / LE Scanner
GATT_CB=$(echo "$DUMP" | awk '/^BTA_GATTC_CB state/ { print $0; exit }')
printf "  ${C_BOLD}%-22s${C_RESET} : %s\n" "GATT Client Stack" "${GATT_CB:-GATT Active}"

echo
echo -e "${C_MAGENTA}[ System Property Profile Configurations ]${C_RESET}"
run_root "getprop" 2>/dev/null | awk -F': ' '
/\[bluetooth\.profile\./ {
  key=$1; val=$2;
  gsub(/[\[\]]/, "", key);
  gsub(/[\[\]]/, "", val);
  sub(/^bluetooth\.profile\./, "", key);
  if (val == "true") {
    printf "  \033[1;32m•\033[0m %-25s : \033[1;32menabled\033[0m\n", key
  } else {
    printf "  \033[2m• %-25s : disabled\033[0m\n", key
  }
}
' | sort
echo -e "${C_CYAN}====================================================${C_RESET}"
