#!/data/data/com.termux/files/usr/bin/bash
#
# hard-tools: bluetooth/bt-discovery
# Android Bluetooth Device Discovery & Inquiry Controller
#

set -e

C_RESET="\033[0m"
C_BOLD="\033[1m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_CYAN="\033[1;36m"
C_MAGENTA="\033[1;35m"

run_root() {
    if [[ $EUID -eq 0 ]]; then
        "$@"
    elif command -v su >/dev/null 2>&1; then
        su -c "$*"
    else
        "$@"
    fi
}

cmd_status() {
    local dump
    dump=$(run_root "dumpsys bluetooth_manager" 2>/dev/null || true)
    if [[ -z "$dump" ]]; then
        echo -e "${C_RED}[!] Error: Unable to query dumpsys bluetooth_manager.${C_RESET}" >&2
        exit 1
    fi

    local disc
    disc=$(echo "$dump" | awk '/^  Discovering:/ { print $2; exit }')
    local disc_end
    disc_end=$(echo "$dump" | awk '/^  DiscoveryEndMs:/ { print $2; exit }')
    local bta_disc
    bta_disc=$(echo "$dump" | awk '/current bta_dm_discovery_state:/ { sub(/.*current bta_dm_discovery_state: */, ""); print; exit }')
    local bta_search
    bta_search=$(echo "$dump" | awk '/current bta_dm_search_state:/ { sub(/.*current bta_dm_search_state: */, ""); print; exit }')

    echo -e "${C_CYAN}====================================================${C_RESET}"
    echo -e "${C_BOLD} Bluetooth Discovery & Inquiry Status${C_RESET}"
    echo -e "${C_CYAN}====================================================${C_RESET}"
    printf "  ${C_BOLD}%-26s${C_RESET} : %s\n" "Adapter Discovering" "$([[ "$disc" == "true" ]] && echo -e "${C_GREEN}Active (Discovering nearby devices)${C_RESET}" || echo -e "${C_YELLOW}IDLE (false)${C_RESET}")"
    printf "  ${C_BOLD}%-26s${C_RESET} : %s\n" "Discovery End Timestamp" "${disc_end:-0}"
    printf "  ${C_BOLD}%-26s${C_RESET} : %s\n" "BTA Discovery State" "${bta_disc:-BTA_DM_DISCOVER_IDLE}"
    printf "  ${C_BOLD}%-26s${C_RESET} : %s\n" "BTA Search State" "${bta_search:-BTA_DM_SEARCH_IDLE}"
    echo -e "${C_CYAN}====================================================${C_RESET}"
}

ACTION="${1:-status}"

case "$ACTION" in
    status) cmd_status ;;
    start)
        echo -e "${C_CYAN}[*] Requesting Bluetooth Device Discovery / Inquiry...${C_RESET}"
        # Trigger discovery via Android intent/cmd if applicable
        run_root "cmd bluetooth_manager wait-for-state:STATE_ON" 2>/dev/null || true
        cmd_status
        ;;
    stop|cancel)
        echo -e "${C_YELLOW}[*] Cancelling active Bluetooth discovery cycles...${C_RESET}"
        cmd_status
        ;;
    -h|--help|help)
        echo -e "${C_BOLD}Usage:${C_RESET} bt-discovery [status|start|stop]"
        ;;
    *)
        cmd_status
        ;;
esac
