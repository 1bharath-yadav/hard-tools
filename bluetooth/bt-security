#!/data/data/com.termux/files/usr/bin/bash
#
# hard-tools: bluetooth/bt-security
# Bluetooth Device Link-Layer Security & Key Assessment
#

set -e

C_RESET="\033[0m"
C_BOLD="\033[1m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_CYAN="\033[1;36m"
C_MAGENTA="\033[1;35m"
C_DIM="\033[2m"

TARGET="$1"

run_root() {
    if [[ $EUID -eq 0 ]]; then
        "$@"
    elif command -v su >/dev/null 2>&1; then
        su -c "$*"
    else
        "$@"
    fi
}

DUMP=$(run_root "dumpsys bluetooth_manager" 2>/dev/null || true)
if [[ -z "$DUMP" ]]; then
    echo -e "\033[1;31m[!] Error: Unable to query dumpsys bluetooth_manager.${C_RESET}" >&2
    exit 1
fi

echo -e "${C_CYAN}===============================================================================${C_RESET}"
echo -e "${C_BOLD} Bluetooth Security Assessment & Link-Key Auditor${C_RESET}"
echo -e "${C_CYAN}===============================================================================${C_RESET}"

echo "$DUMP" | awk -v tgt="$TARGET" '
BEGIN { IGNORECASE=1; found=0 }
/^shim::record / {
  line=$0
  match(line, /([0-9A-Za-z]{2}:){5}[0-9A-Za-z]{2}/)
  addr=substr(line, RSTART, RLENGTH)
  
  name="Unknown"
  if (match(line, /name:"[^"]+"/)) {
    name=substr(line, RSTART+6, RLENGTH-7)
  }

  if (tgt != "" && tolower(addr) !~ tolower(tgt) && tolower(name) !~ tolower(tgt)) {
    next
  }

  found=1
  key_type="Unknown"
  if (match(line, /bredr_linkkey_type:[^,]+/)) {
    k=substr(line, RSTART, RLENGTH)
    sub(/^bredr_linkkey_type:/, "", k)
    key_type=k
  }

  bond_type="Unknown"
  if (match(line, /bond_type:[^,]+/)) {
    b=substr(line, RSTART, RLENGTH)
    sub(/^bond_type:/, "", b)
    bond_type=b
  }

  mitm="No (Just Works / Unauthenticated)"
  mitm_color="\033[1;33m"
  if (line ~ /16_digit_key_authenticated:T/) {
    mitm="Yes (16-Digit MITM Protection)"
    mitm_color="\033[1;32m"
  }

  sec_rating="\033[1;33mMEDIUM\033[0m"
  if (key_type ~ /AUTH_COMB_P_256/) {
    sec_rating="\033[1;32mSTRONG (P-256 SC)\033[0m"
  } else if (key_type ~ /UNAUTH_COMB/) {
    sec_rating="\033[1;33mSTANDARD (Unauthenticated Combination)\033[0m"
  }

  printf "  \033[1;36m• Device:\033[0m \033[1;32m%-22s\033[0m (\033[1m%s\033[0m)\n", name, addr
  printf "    ↳ Security Rating : %s\n", sec_rating
  printf "    ↳ Link Key Type   : \033[1m%s\033[0m\n", key_type
  printf "    ↳ MITM Protection : " mitm_color "%s\033[0m\n", mitm
  printf "    ↳ Bond Storage    : %s\n", bond_type
  print ""
}
END {
  if (!found) {
    print "  No matching bonded device security records found."
  }
}
'
echo -e "${C_CYAN}===============================================================================${C_RESET}"
