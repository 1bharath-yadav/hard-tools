#!/data/data/com.termux/files/usr/bin/bash
#
# hard-tools: bluetooth/bt-scan
# Android Bluetooth Live Scanner Telemetry & Client Tracker
#

set -e

C_RESET="\033[0m"
C_BOLD="\033[1m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_CYAN="\033[1;36m"
C_MAGENTA="\033[1;35m"
C_DIM="\033[2m"

FOLLOW=0
INTERVAL=2

for arg in "$@"; do
    case "$arg" in
        -f|--follow|-w|--watch) FOLLOW=1 ;;
        [0-9]*) INTERVAL="$arg"; FOLLOW=1 ;;
    esac
done

run_root() {
    if [[ $EUID -eq 0 ]]; then
        "$@"
    elif command -v su >/dev/null 2>&1; then
        su -c "$*"
    else
        "$@"
    fi
}

display_scan_telemetry() {
    local dump
    dump=$(run_root "dumpsys bluetooth_manager" 2>/dev/null || true)
    if [[ -z "$dump" ]]; then
        echo -e "\033[1;31m[!] Error: Unable to query dumpsys bluetooth_manager. Root required.\033[0m" >&2
        return 1
    fi

    # Discovery state
    local disc_state
    disc_state=$(echo "$dump" | awk '/^  Discovering:/ { print $2; exit }')
    local disc_color="$C_YELLOW"
    [[ "$disc_state" == "true" ]] && disc_color="$C_GREEN" || disc_state="IDLE (No active inquiry)"

    echo -e "${C_CYAN}================================================================================${C_RESET}"
    echo -e "${C_BOLD} Android Bluetooth Scanner Telemetry & Activity Engine${C_RESET}"
    echo -e "${C_CYAN}================================================================================${C_RESET}"
    printf "  ${C_BOLD}%-26s${C_RESET} : ${disc_color}%s${C_RESET}\n" "Adapter Discovery State" "$disc_state"
    echo

    # Active Scanner Clients from LE Scanner Map
    echo -e "${C_MAGENTA}[ Active Scanner Client Applications ]${C_RESET}"
    echo "$dump" | awk '
    /^LE Scanner Map:/ { in_map=1; next }
    /^[A-Z][a-zA-Z0-9 ]+:/ && !/^LE Scanner Map:/ { in_map=0 }
    in_map {
      if (/^[ ]+[a-zA-Z0-9._]+:$/) {
        app=$1
        sub(/:$/, "", app)
        printf "  \033[1;32m❖\033[0m \033[1m%-35s\033[0m\n", app
      }
      if (/LE scans[ ]+\(started\/stopped\)/) {
        sub(/.*:[ ]*/, "")
        printf "    \033[2m• Scans (started/stopped) : %s\033[0m\n", $0
      }
      if (/Scan time\(ms\)[ ]+\(active\/suspend\/total\)/) {
        sub(/.*:[ ]*/, "")
        printf "    \033[2m• Scan Time (ms)          : %s\033[0m\n", $0
      }
      if (/Last [0-9]+ scans:/) {
        in_scans=1
      }
      if (in_scans && /Duration:/) {
        line=$0
        gsub(/^[ ]+/, "", line)
        printf "    \033[1;36m↳\033[0m Recent Scan Config : %s\n", line
      }
      if (in_scans && /BluetoothLeScanFilter/) {
        line=$0
        gsub(/^[ ]+/, "", line)
        printf "      \033[2mFilter: %s\033[0m\n", line
      }
    }
    '
    echo

    # Recent Scan Events from shim::btm
    echo -e "${C_MAGENTA}[ Recent Scan Activity & Start/Stop Events (shim::btm) ]${C_RESET}"
    printf "  ${C_BOLD}%-12s %-18s %-16s %s${C_RESET}\n" "TIMESTAMP" "EVENT" "TARGET ADDRESS" "DURATION / RESULTS"
    echo -e "  ----------------------------------------------------------------------------"
    
    echo "$dump" | awk '
    /^shim::btm/ && /SCAN/ {
      date=$2
      time=$3
      
      line=$0
      sub(/^.*SCAN[ ]+/, "", line)
      
      event="Unknown"
      if (line ~ /^Le scan started/) event="Le scan started"
      else if (line ~ /^Le scan stopped/) event="Le scan stopped"
      else if (line ~ /^Classic inquiry started/) event="Classic inquiry started"
      else if (line ~ /^Classic inquiry stopped/) event="Classic inquiry stopped"
      else if (line ~ /^Classic updated/) event="Classic updated"
      else {
        match(line, /^[^:]+/)
        event=substr(line, RSTART, RLENGTH)
      }
      
      addr=""
      if (match(line, /([0-9A-Za-z]{2}:){5}[0-9A-Za-z]{2}/)) {
        addr=substr(line, RSTART, RLENGTH)
      }
      
      dur=""
      if (match(line, /duration_s:[ ]*[0-9.]+/)) {
        dur=substr(line, RSTART, RLENGTH)
      }
      res=""
      if (match(line, /results:[0-9]+/)) {
        res=substr(line, RSTART, RLENGTH)
      }
      
      ev_color="\033[1;32m"
      if (event ~ /stopped/) ev_color="\033[1;33m"
      else if (event ~ /updated/) ev_color="\033[1;36m"
      
      printf "  %-12s " ev_color "%-24s\033[0m %-18s %s %s\n", time, event, addr, dur, res
    }
    ' | tail -n 12

    echo -e "${C_CYAN}================================================================================${C_RESET}"
}

if [[ $FOLLOW -eq 1 ]]; then
    trap 'echo -e "\n\033[1;36m[*] Exiting Scanner Monitor. Goodbye!\033[0m"; exit 0' INT TERM
    while true; do
        clear 2>/dev/null || true
        display_scan_telemetry
        echo -e "\033[2mStreaming scan telemetry every ${INTERVAL}s. Press Ctrl+C to stop.\033[0m"
        sleep "$INTERVAL"
    done
else
    display_scan_telemetry
fi
