#!/data/data/com.termux/files/usr/bin/bash
#
# hard-tools: bluetooth/bt-services
# Bluetooth Profile Services & UUID Discovery Inspector
#

set -e

C_RESET="\033[0m"
C_BOLD="\033[1m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_CYAN="\033[1;36m"
C_MAGENTA="\033[1;35m"
C_DIM="\033[2m"

TARGET="$1"

run_root() {
    if [[ $EUID -eq 0 ]]; then
        "$@"
    elif command -v su >/dev/null 2>&1; then
        su -c "$*"
    else
        "$@"
    fi
}

DUMP=$(run_root "dumpsys bluetooth_manager" 2>/dev/null || true)
if [[ -z "$DUMP" ]]; then
    echo -e "\033[1;31m[!] Error: Unable to query dumpsys bluetooth_manager.${C_RESET}" >&2
    exit 1
fi

translate_uuid() {
    local u="$1"
    case "$u" in
        *1108-*) echo "Headset Profile (HSP - 0x1108)" ;;
        *110b-*) echo "Audio Sink / A2DP Sink (0x110B)" ;;
        *110a-*) echo "Audio Source / A2DP Source (0x110A)" ;;
        *110e-*) echo "A/V Remote Control Target (AVRCP - 0x110E)" ;;
        *110c-*) echo "A/V Remote Control (AVRCP - 0x110C)" ;;
        *111e-*) echo "Handsfree Profile (HFP - 0x111E)" ;;
        *111f-*) echo "Handsfree Audio Gateway (0x111F)" ;;
        *1124-*) echo "Human Interface Device (HID - 0x1124)" ;;
        *1101-*) echo "Serial Port Profile (SPP - 0x1101)" ;;
        *1115-*) echo "Personal Area Networking User (PANU - 0x1115)" ;;
        *1116-*) echo "Network Access Point (NAP - 0x1116)" ;;
        *112f-*) echo "Phonebook Access Profile (PBAP - 0x112F)" ;;
        *1132-*) echo "Message Access Profile (MAP - 0x1132)" ;;
        *1105-*) echo "Object Push Profile (OPP - 0x1105)" ;;
        *fe01-*) echo "Google FastPair / Extension (0xFE01)" ;;
        *)       echo "Custom / Vendor Service ($u)" ;;
    esac
}

echo -e "${C_CYAN}===============================================================================${C_RESET}"
echo -e "${C_BOLD} Bluetooth Services & Advertised UUID Discovery${C_RESET}"
echo -e "${C_CYAN}===============================================================================${C_RESET}"

echo "$DUMP" | awk -v tgt="$TARGET" '
BEGIN {
  IGNORECASE=1
  found_any=0
}
/^BluetoothRemoteDevices/,/^BluetoothActiveDeviceManager/ {
  if (/^[ ]+([0-9A-Za-z]{2}:){5}[0-9A-Za-z]{2}/) {
    if (in_dev && (tgt == "" || dev_match)) {
      print "DEV_END"
    }
    in_dev=1
    line=$0
    match(line, /([0-9A-Za-z]{2}:){5}[0-9A-Za-z]{2}/)
    addr=substr(line, RSTART, RLENGTH)
    sub(/.*\][ ]*/, "", line)
    name=line
    
    dev_match=0
    if (tgt == "" || tolower(addr) ~ tolower(tgt) || tolower(name) ~ tolower(tgt)) {
      dev_match=1
      found_any=1
      printf "DEVICE|%s|%s\n", addr, name
    }
    next
  }
  if (in_dev && dev_match && /\[BR\/EDR UUIDs\]:/) {
    sub(/.*\[BR\/EDR UUIDs\]:[ ]*/, "")
    print "BRED|" $0
  }
  if (in_dev && dev_match && /\[LE UUIDs[ ]*\]:/) {
    sub(/.*\[LE UUIDs[ ]*\]:[ ]*/, "")
    print "LE|" $0
  }
}
END {
  if (in_dev && (tgt == "" || dev_match)) print "DEV_END"
}
' | while IFS='|' read -r type val1 val2; do
    case "$type" in
        DEVICE)
            echo -e "  \033[1;36m• Device:\033[0m \033[1;32m${val2}\033[0m (\033[1m${val1}\033[0m)"
            ;;
        BRED)
            for u in $val1; do
                printf "    \033[1;32m✓\033[0m [BR/EDR] %s\n" "$(translate_uuid "$u")"
            done
            ;;
        LE)
            for u in $val1; do
                printf "    \033[1;36m❖\033[0m [LE]     %s\n" "$(translate_uuid "$u")"
            done
            ;;
        DEV_END)
            echo
            ;;
    esac
done

echo -e "${C_CYAN}===============================================================================${C_RESET}"
