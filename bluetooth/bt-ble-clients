#!/data/data/com.termux/files/usr/bin/bash
#
# hard-tools: bluetooth/bt-ble-clients
# Active BLE Scanner Client Applications & Registered Filters
#

set -e

C_RESET="\033[0m"
C_BOLD="\033[1m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_CYAN="\033[1;36m"
C_MAGENTA="\033[1;35m"
C_DIM="\033[2m"

run_root() {
    if [[ $EUID -eq 0 ]]; then
        "$@"
    elif command -v su >/dev/null 2>&1; then
        su -c "$*"
    else
        "$@"
    fi
}

DUMP=$(run_root "dumpsys bluetooth_manager" 2>/dev/null || true)
if [[ -z "$DUMP" ]]; then
    echo -e "\033[1;31m[!] Error: Unable to query dumpsys bluetooth_manager.${C_RESET}" >&2
    exit 1
fi

echo -e "${C_CYAN}===============================================================================${C_RESET}"
echo -e "${C_BOLD} Registered BLE Scanner Client Applications${C_RESET}"
echo -e "${C_CYAN}===============================================================================${C_RESET}"

echo "$DUMP" | awk '
/^LE Scanner Map:/ { in_map=1; count=0; next }
/^[A-Z][a-zA-Z0-9 ]+:/ && !/^LE Scanner Map:/ { in_map=0 }
in_map {
  if (/^[ ]+[a-zA-Z0-9._]+:$/) {
    count++
    app=$1
    sub(/:$/, "", app)
    printf "  \033[1;36m• Package:\033[0m \033[1;32m%s\033[0m\n", app
  }
  if (/LE scans[ ]+\(started\/stopped\)/) {
    sub(/.*:[ ]*/, "")
    printf "    ↳ Scans (Started / Stopped) : \033[1m%s\033[0m\n", $0
  }
  if (/Scan time\(ms\)[ ]+\(active\/suspend\/total\)/) {
    sub(/.*:[ ]*/, "")
    printf "    ↳ Active Scan Time (ms)     : %s\n", $0
  }
  if (/Scan time per mode\(ms\)/) {
    sub(/.*:[ ]*/, "")
    printf "    ↳ Mode Distribution (ms)    : \033[2m%s\033[0m\n", $0
  }
  if (/Last [0-9]+ scans:/) {
    in_scans=1
    printf "    ↳ \033[1;33mRecent Scan Filters & Config:\033[0m\n"
  }
  if (in_scans && /Duration:/) {
    line=$0
    gsub(/^[ ]+/, "", line)
    printf "      - \033[1;36mScan:\033[0m %s\n", line
  }
  if (in_scans && /BluetoothLeScanFilter/) {
    line=$0
    gsub(/^[ ]+/, "", line)
    printf "        \033[2mFilter: %s\033[0m\n", line
  }
}
END {
  if (count == 0) {
    print "  No active BLE scanner client registrations (Idle / Awaiting scan event)."
  }
}
'
echo -e "${C_CYAN}===============================================================================${C_RESET}"
