#!/data/data/com.termux/files/usr/bin/bash
#
# hard-tools: bluetooth/bt-status
# Android Bluetooth Status & Adapter Inspector
#

set -e

# ANSI Color codes
C_RESET="\033[0m"
C_BOLD="\033[1m"
C_RED="\033[1;31m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_BLUE="\033[1;34m"
C_CYAN="\033[1;36m"
C_DIM="\033[2m"

run_root() {
    if [[ $EUID -eq 0 ]]; then
        "$@"
    elif command -v su >/dev/null 2>&1; then
        su -c "$*"
    else
        "$@"
    fi
}

get_dump() {
    run_root "dumpsys bluetooth_manager" 2>/dev/null || true
}

MODE="pretty"
if [[ "${1:-}" == "--json" || "${1:-}" == "-j" ]]; then
    MODE="json"
elif [[ "${1:-}" == "--raw" || "${1:-}" == "-r" ]]; then
    MODE="raw"
elif [[ "${1:-}" == "--quiet" || "${1:-}" == "-q" ]]; then
    MODE="quiet"
fi

DUMP=$(get_dump)

if [[ -z "$DUMP" ]]; then
    if [[ "$MODE" == "json" ]]; then
        echo '{"error": "Failed to query dumpsys bluetooth_manager. Root permission required."}'
    elif [[ "$MODE" != "quiet" ]]; then
        echo -e "${C_RED}[!] Error: Cannot access Android Bluetooth Manager. Ensure root permissions.${C_RESET}" >&2
    fi
    exit 1
fi

PARSED=$(echo "$DUMP" | awk '
/^Bluetooth Status/ { in_status=1; next }
/^[A-Z][a-zA-Z0-9 ]+:/ && !/^Bluetooth Status/ { in_status=0 }
in_status && /^  enabled:/ { sub(/^  enabled: */, ""); enabled=$0 }
in_status && /^  state:/ { sub(/^  state: */, ""); state=$0 }
in_status && /^  address:/ { sub(/^  address: */, ""); addr=$0 }
in_status && /^  name:/ { sub(/^  name: */, ""); name=$0 }
in_status && /^  time since enabled:/ { sub(/^  time since enabled: */, ""); uptime=$0 }

/^  Bonded devices:/ {
  sub(/^  Bonded devices: */, "");
  bonded=$0;
}

/^BluetoothActiveDeviceManager/,/^ScanMode:/ {
  if (/^  A2DP:/) { in_a2dp=1; next }
  if (/^  HFP:/) { in_a2dp=0; in_hfp=1; next }
  if (/^  HA:/ || /^  LE Audio:/) { in_a2dp=0; in_hfp=0 }
  if (in_a2dp && /^    Active:/) { sub(/^    Active: */, ""); a2dp_active=$0 }
  if (in_hfp && /^    Active:/) { sub(/^    Active: */, ""); hfp_active=$0 }
}

END {
  if (enabled == "") enabled = "false"
  if (state == "") state = "OFF"
  if (addr == "") addr = "Unknown"
  if (name == "") name = "Unknown"
  if (uptime == "") uptime = "0s"
  if (bonded == "") bonded = "0"
  if (a2dp_active == "") a2dp_active = "NULL"
  if (hfp_active == "") hfp_active = "NULL"

  print enabled "|" state "|" addr "|" name "|" uptime "|" bonded "|" a2dp_active "|" hfp_active
}
')

IFS='|' read -r ENABLED STATE ADDR NAME UPTIME BONDED A2DP_ACTIVE HFP_ACTIVE <<< "$PARSED"

if [[ "$MODE" == "quiet" ]]; then
    if [[ "$ENABLED" == "true" || "$STATE" == "STATE_ON" || "$STATE" == "BLE_ON" ]]; then
        exit 0
    else
        exit 1
    fi
fi

if [[ "$MODE" == "raw" ]]; then
    echo "ENABLED=$ENABLED"
    echo "STATE=$STATE"
    echo "ADDRESS=$ADDR"
    echo "NAME=$NAME"
    echo "UPTIME=$UPTIME"
    echo "BONDED_DEVICES=$BONDED"
    echo "A2DP_ACTIVE=$A2DP_ACTIVE"
    echo "HFP_ACTIVE=$HFP_ACTIVE"
    exit 0
fi

if [[ "$MODE" == "json" ]]; then
    cat << JSON_EOF
{
  "enabled": ${ENABLED},
  "state": "${STATE}",
  "address": "${ADDR}",
  "name": "${NAME}",
  "uptime": "${UPTIME}",
  "bonded_devices": ${BONDED},
  "active_a2dp": "${A2DP_ACTIVE}",
  "active_hfp": "${HFP_ACTIVE}"
}
JSON_EOF
    exit 0
fi

# Pretty TUI output
STATE_COLOR="$C_RED"
if [[ "$ENABLED" == "true" || "$STATE" == "STATE_ON" ]]; then
    STATE_COLOR="$C_GREEN"
elif [[ "$STATE" == "BLE_ON" ]]; then
    STATE_COLOR="$C_YELLOW"
fi

echo -e "${C_CYAN}====================================================${C_RESET}"
echo -e "${C_BOLD} Android Bluetooth Status (${C_CYAN}bluetooth_manager${C_RESET}${C_BOLD})${C_RESET}"
echo -e "${C_CYAN}====================================================${C_RESET}"
printf "  ${C_BOLD}%-16s${C_RESET} : ${STATE_COLOR}%s${C_RESET} (Enabled: %s)\n" "Power / State" "$STATE" "$ENABLED"
printf "  ${C_BOLD}%-16s${C_RESET} : ${C_CYAN}%s${C_RESET}\n" "Adapter Address" "$ADDR"
printf "  ${C_BOLD}%-16s${C_RESET} : ${C_BOLD}%s${C_RESET}\n" "Device Name" "$NAME"
printf "  ${C_BOLD}%-16s${C_RESET} : %s\n" "Adapter Uptime" "$UPTIME"
printf "  ${C_BOLD}%-16s${C_RESET} : %s paired\n" "Bonded Devices" "$BONDED"
printf "  ${C_BOLD}%-16s${C_RESET} : %s\n" "Active A2DP Audio" "$A2DP_ACTIVE"
printf "  ${C_BOLD}%-16s${C_RESET} : %s\n" "Active HFP Voice" "$HFP_ACTIVE"
echo -e "${C_CYAN}====================================================${C_RESET}"
