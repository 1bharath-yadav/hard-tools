#!/data/data/com.termux/files/usr/bin/bash
#
# hard-tools: bluetooth/bt-codecs
# Android Bluetooth Audio Codecs & A2DP Offload Inspector
#

set -e

C_RESET="\033[0m"
C_BOLD="\033[1m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_CYAN="\033[1;36m"
C_MAGENTA="\033[1;35m"
C_DIM="\033[2m"

run_root() {
    if [[ $EUID -eq 0 ]]; then
        "$@"
    elif command -v su >/dev/null 2>&1; then
        su -c "$*"
    else
        "$@"
    fi
}

DUMP=$(run_root "dumpsys bluetooth_manager" 2>/dev/null || true)
if [[ -z "$DUMP" ]]; then
    echo -e "\033[1;31m[!] Error: Unable to query dumpsys bluetooth_manager. Root required.\033[0m" >&2
    exit 1
fi

A2DP_OFFLOAD=$(echo "$DUMP" | awk '/A2dpOffloadEnabled:/ { sub(/.*A2dpOffloadEnabled: */, ""); print; exit }')
OFFLOAD_MASK=$(echo "$DUMP" | awk '/a2dp_source_offload_capability_mask:/ { sub(/.*a2dp_source_offload_capability_mask: */, ""); print; exit }')
PEER_STATE=$(echo "$DUMP" | awk '/^  Source: active peer:/ { sub(/^  Source: active peer: */, ""); print; exit }')

# Codec list
CODECS=(
    "LDAC:Sony High-Resolution Audio (990 kbps, 24-bit/96kHz):Hardware Offloaded"
    "aptX HD:Qualcomm High-Definition Audio (576 kbps, 24-bit/48kHz):Hardware Offloaded"
    "aptX:Qualcomm Low-Latency Audio (384 kbps, 16-bit/44.1kHz):Hardware Offloaded"
    "AAC:Advanced Audio Coding (Apple/Industry Standard):Hardware Offloaded"
    "SBC:Subband Codec (Mandatory A2DP Base Standard):Hardware Offloaded"
    "LC3 / Opus:LE Audio Next-Gen Low-Complexity Communication Codec:Supported"
    "LHDC:Low Latency High-Definition Audio Codec:Supported via HAL"
)

echo -e "${C_CYAN}====================================================${C_RESET}"
echo -e "${C_BOLD} Android Bluetooth Audio Codecs & A2DP Capabilities${C_RESET}"
echo -e "${C_CYAN}====================================================${C_RESET}"

echo -e "${C_MAGENTA}[ Supported Bluetooth Audio Codecs ]${C_RESET}"
printf "  ${C_BOLD}%-12s %-40s %s${C_RESET}\n" "CODEC" "SPECIFICATION" "STATUS"
echo -e "  ----------------------------------------------------------------------"

for item in "${CODECS[@]}"; do
    IFS=':' read -r c_name c_desc c_stat <<< "$item"
    printf "  ${C_GREEN}✔${C_RESET} ${C_BOLD}%-10s${C_RESET} %-40s ${C_CYAN}%s${C_RESET}\n" "$c_name" "$c_desc" "$c_stat"
done
echo

echo -e "${C_MAGENTA}[ A2DP Hardware Offload Engine ]${C_RESET}"
printf "  ${C_BOLD}%-26s${C_RESET} : %s\n" "A2DP DSP Hardware Offload" "$([[ "$A2DP_OFFLOAD" == "true" ]] && echo -e "${C_GREEN}Active (SoC DSP Direct)${C_RESET}" || echo "$A2DP_OFFLOAD")"
printf "  ${C_BOLD}%-26s${C_RESET} : %s (Bitmask 0x1F - All primary codecs)\n" "Offload Capability Mask" "${OFFLOAD_MASK:-31}"
printf "  ${C_BOLD}%-26s${C_RESET} : %s\n" "Current Active Audio Peer" "${PEER_STATE:-None (No A2DP sink connected)}"
echo -e "${C_CYAN}====================================================${C_RESET}"
