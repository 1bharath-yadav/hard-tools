#!/data/data/com.termux/files/usr/bin/bash
#
# hard-tools: bluetooth/bt-pan-status
# Dedicated Android Bluetooth PAN Interface & Gateway Status
#

set -e

C_RESET="\033[0m"
C_BOLD="\033[1m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_CYAN="\033[1;36m"
C_MAGENTA="\033[1;35m"
C_DIM="\033[2m"

run_root() {
    if [[ $EUID -eq 0 ]]; then
        "$@"
    elif command -v su >/dev/null 2>&1; then
        su -c "$*"
    else
        "$@"
    fi
}

DUMP=$(run_root "dumpsys bluetooth_manager" 2>/dev/null || true)

PAN_SHIM=$(echo "$DUMP" | awk '/shim::legacy::pan Connections:/ { print; exit }')
PAN_CONN="0"
if [[ "$PAN_SHIM" =~ Connections:([0-9]+) ]]; then
    PAN_CONN="${BASH_REMATCH[1]}"
fi

NAP_PROP=$(run_root "getprop bluetooth.profile.pan.nap.enabled" 2>/dev/null || echo "unknown")
PANU_PROP=$(run_root "getprop bluetooth.profile.pan.panu.enabled" 2>/dev/null || echo "unknown")

IFACE_EXISTS=0
IFACE_INFO=$(run_root "ip addr show bt-pan 2>/dev/null" || true)
[[ -n "$IFACE_INFO" ]] && IFACE_EXISTS=1

echo -e "${C_CYAN}====================================================${C_RESET}"
echo -e "${C_BOLD} Bluetooth PAN & Tethering Gateway Status${C_RESET}"
echo -e "${C_CYAN}====================================================${C_RESET}"
printf "  ${C_BOLD}%-24s${C_RESET} : %s\n" "NAP Role (Access Point)" "$([[ "$NAP_PROP" == "true" ]] && echo -e "${C_GREEN}Active${C_RESET}" || echo "$NAP_PROP")"
printf "  ${C_BOLD}%-24s${C_RESET} : %s\n" "PANU Role (User Client)" "$([[ "$PANU_PROP" == "true" ]] && echo -e "${C_GREEN}Active${C_RESET}" || echo "$PANU_PROP")"
printf "  ${C_BOLD}%-24s${C_RESET} : %s\n" "Active PAN Clients" "$PAN_CONN"
printf "  ${C_BOLD}%-24s${C_RESET} : %s\n" "Kernel Network Device" "$([[ $IFACE_EXISTS -eq 1 ]] && echo -e "${C_GREEN}UP (bt-pan)${C_RESET}" || echo -e "${C_YELLOW}STANDBY (Created on connection)${C_RESET}")"

if [[ $IFACE_EXISTS -eq 1 ]]; then
    echo
    echo -e "${C_MAGENTA}[ IP Address & Route ]${C_RESET}"
    echo "$IFACE_INFO" | sed 's/^/  /'
fi
echo -e "${C_CYAN}====================================================${C_RESET}"
