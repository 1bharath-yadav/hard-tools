#!/data/data/com.termux/files/usr/bin/bash
#
# hard-tools: bluetooth/bt-reset
# Soft Recovery & Fast Cycling for Android Bluetooth Adapter
#

set -e

C_RESET="\033[0m"
C_BOLD="\033[1m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_CYAN="\033[1;36m"

run_root() {
    if [[ $EUID -eq 0 ]]; then
        "$@"
    elif command -v su >/dev/null 2>&1; then
        su -c "$*"
    else
        "$@"
    fi
}

get_state_code() {
    local raw
    raw=$(run_root "service call bluetooth_manager 3" 2>/dev/null || true)
    echo "$raw" | awk '/Result: Parcel/ { print $4 }'
}

echo -e "${C_CYAN}====================================================${C_RESET}"
echo -e "${C_BOLD} Android Bluetooth Adapter Soft Recovery / Reset${C_RESET}"
echo -e "${C_CYAN}====================================================${C_RESET}"

echo -e "${C_YELLOW}[1/4] Disabling Bluetooth adapter...${C_RESET}"
run_root "cmd bluetooth_manager disable" >/dev/null 2>&1 || true

echo -e "${C_CYAN}[2/4] Waiting for adapter state: STATE_OFF...${C_RESET}"
for i in {1..10}; do
    st=$(get_state_code)
    if [[ "$st" =~ 000a$|10$ ]]; then
        echo -e "  ${C_GREEN}✓ Adapter is OFF.${C_RESET}"
        break
    fi
    sleep 0.5
done

echo -e "${C_YELLOW}[3/4] Re-enabling Bluetooth adapter...${C_RESET}"
run_root "cmd bluetooth_manager enable" >/dev/null 2>&1 || true

echo -e "${C_CYAN}[4/4] Waiting for adapter state: STATE_ON...${C_RESET}"
for i in {1..10}; do
    st=$(get_state_code)
    if [[ "$st" =~ 000c$|12$ ]]; then
        echo -e "  ${C_GREEN}✓ Adapter is ON.${C_RESET}"
        break
    fi
    sleep 0.5
done

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -x "${DIR}/bt-status-fast" ]]; then
    "${DIR}/bt-status-fast"
fi
echo -e "${C_GREEN}[+] Bluetooth Stack Reset & Re-initialization Complete.${C_RESET}"
echo -e "${C_CYAN}====================================================${C_RESET}"
