#!/data/data/com.termux/files/usr/bin/bash
#
# hard-tools: bluetooth/bt-devices
# Android Paired & Known Bluetooth Devices Parser
#

set -e

C_RESET="\033[0m"
C_BOLD="\033[1m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_CYAN="\033[1;36m"
C_MAGENTA="\033[1;35m"
C_DIM="\033[2m"

VERBOSE=0
JSON_MODE=0

for arg in "$@"; do
    case "$arg" in
        -v|--verbose) VERBOSE=1 ;;
        -j|--json)    JSON_MODE=1 ;;
    esac
done

run_root() {
    if [[ $EUID -eq 0 ]]; then
        "$@"
    elif command -v su >/dev/null 2>&1; then
        su -c "$*"
    else
        "$@"
    fi
}

DUMP=$(run_root "dumpsys bluetooth_manager" 2>/dev/null || true)
if [[ -z "$DUMP" ]]; then
    echo -e "\033[1;31m[!] Error: Unable to query dumpsys bluetooth_manager. Root required.\033[0m" >&2
    exit 1
fi

if [[ $JSON_MODE -eq 1 ]]; then
    echo "$DUMP" | awk -v verbose="$VERBOSE" '
    BEGIN {
      print "["
      first=1
    }
    /^  Bonded devices:/ { in_bonded=1; next }
    /^[A-Z][a-zA-Z0-9 ]+:/ && !/^  Bonded devices:/ { in_bonded=0 }
    in_bonded && /^[ ]+([0-9A-Za-z]{2}:){5}[0-9A-Za-z]{2}/ {
      line=$0
      match(line, /([0-9A-Za-z]{2}:){5}[0-9A-Za-z]{2}/)
      addr=substr(line, RSTART, RLENGTH)

      trans="BR/EDR"
      if (match(line, /\[[ ]*(BR\/EDR|LE|DUAL)[ ]*\]/)) {
        trans=substr(line, RSTART+1, RLENGTH-2)
        gsub(/ /, "", trans)
      }

      cod="Unknown"
      if (match(line, /\[0x[0-9A-Fa-f]+\]/)) {
        cod=substr(line, RSTART+1, RLENGTH-2)
      }

      name=line
      sub(/.*\][ ]*/, "", name)
      gsub(/"/, "\\\"", name)

      if (!first) print ","
      first=0
      printf "  {\"address\": \"%s\", \"name\": \"%s\", \"transport\": \"%s\", \"cod\": \"%s\"}", addr, name, trans, cod
    }
    END {
      print "\n]"
    }
    '
    exit 0
fi

echo -e "${C_CYAN}================================================================================${C_RESET}"
echo -e "${C_BOLD} Android Known & Bonded Bluetooth Devices${C_RESET}"
echo -e "${C_CYAN}================================================================================${C_RESET}"

BONDED_COUNT=$(echo "$DUMP" | awk '/^  Bonded devices:/ { sub(/^  Bonded devices: */, ""); print; exit }')
printf " ${C_BOLD}Total Bonded Devices:${C_RESET} ${C_GREEN}%s${C_RESET}\n\n" "${BONDED_COUNT:-0}"

printf "  ${C_BOLD}%-3s %-19s %-8s %-10s %s${C_RESET}\n" "#" "MAC ADDRESS" "TYPE" "CLASS(CoD)" "DEVICE NAME"
echo -e "  ----------------------------------------------------------------------------"

echo "$DUMP" | awk -v verbose="$VERBOSE" '
/^  Bonded devices:/ { in_bonded=1; count=0; next }
/^[A-Z][a-zA-Z0-9 ]+:/ && !/^  Bonded devices:/ { in_bonded=0 }
in_bonded && /^[ ]+([0-9A-Za-z]{2}:){5}[0-9A-Za-z]{2}/ {
  count++
  line=$0
  match(line, /([0-9A-Za-z]{2}:){5}[0-9A-Za-z]{2}/)
  addr=substr(line, RSTART, RLENGTH)

  trans="BR/EDR"
  if (match(line, /\[[ ]*(BR\/EDR|LE|DUAL)[ ]*\]/)) {
    trans=substr(line, RSTART+1, RLENGTH-2)
    gsub(/ /, "", trans)
  }

  cod="Unknown"
  if (match(line, /\[0x[0-9A-Fa-f]+\]/)) {
    cod=substr(line, RSTART+1, RLENGTH-2)
  }

  name=line
  sub(/.*\][ ]*/, "", name)

  printf "  \033[1;36m%02d\033[0m  \033[1m%-19s\033[0m %-8s %-10s \033[1;32m%s\033[0m\n", count, addr, trans, cod, name
}
'

if [[ $VERBOSE -eq 1 ]]; then
    echo
    echo -e "${C_MAGENTA}[ Link Keys & Security Profiles (shim::record) ]${C_RESET}"
    echo "$DUMP" | awk '
    /^shim::record / {
      match($0, /([0-9A-Za-z]{2}:){5}[0-9A-Za-z]{2}/)
      addr=substr($0, RSTART, RLENGTH)
      
      key_type="Unknown"
      if (match($0, /bredr_linkkey_type:[^,]+/)) {
        key_str=substr($0, RSTART, RLENGTH)
        sub(/^bredr_linkkey_type:/, "", key_str)
        key_type=key_str
      }
      
      bond_type="Unknown"
      if (match($0, /bond_type:[^,]+/)) {
        bond_str=substr($0, RSTART, RLENGTH)
        sub(/^bond_type:/, "", bond_str)
        bond_type=bond_str
      }

      printf "  • %-19s | Key: %-18s | Bond: %s\n", addr, key_type, bond_type
    }
    '
fi

echo -e "${C_CYAN}================================================================================${C_RESET}"
