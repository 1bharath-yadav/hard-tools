#!/data/data/com.termux/files/usr/bin/bash
#
# hard-tools: bluetooth/bt-paired
# Fast Paired & Bonded Bluetooth Device Inventory
#

set -e

C_RESET="\033[0m"
C_BOLD="\033[1m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_CYAN="\033[1;36m"
C_DIM="\033[2m"

run_root() {
    if [[ $EUID -eq 0 ]]; then
        "$@"
    elif command -v su >/dev/null 2>&1; then
        su -c "$*"
    else
        "$@"
    fi
}

DUMP=$(run_root "dumpsys bluetooth_manager" 2>/dev/null || true)
if [[ -z "$DUMP" ]]; then
    echo -e "\033[1;31m[!] Error: Unable to query dumpsys bluetooth_manager. Root required.\033[0m" >&2
    exit 1
fi

echo -e "${C_CYAN}===============================================================================${C_RESET}"
echo -e "${C_BOLD} Paired & Bonded Bluetooth Device Inventory${C_RESET}"
echo -e "${C_CYAN}===============================================================================${C_RESET}"
printf "  ${C_BOLD}%-24s %-19s %-10s %s${C_RESET}\n" "DEVICE NAME" "MAC ADDRESS" "TRANSPORT" "CLASS(CoD)"
echo -e "  -----------------------------------------------------------------------------"

echo "$DUMP" | awk '
/^  Bonded devices:/ { in_bonded=1; next }
/^[A-Z][a-zA-Z0-9 ]+:/ && !/^  Bonded devices:/ { in_bonded=0 }
in_bonded && /^[ ]+([0-9A-Za-z]{2}:){5}[0-9A-Za-z]{2}/ {
  line=$0
  match(line, /([0-9A-Za-z]{2}:){5}[0-9A-Za-z]{2}/)
  addr=substr(line, RSTART, RLENGTH)

  trans="BR/EDR"
  if (match(line, /\[[ ]*(BR\/EDR|LE|DUAL)[ ]*\]/)) {
    trans=substr(line, RSTART+1, RLENGTH-2)
    gsub(/ /, "", trans)
  }

  cod="Unknown"
  if (match(line, /\[0x[0-9A-Fa-f]+\]/)) {
    cod=substr(line, RSTART+1, RLENGTH-2)
  }

  sub(/.*\][ ]*/, "", line)
  name=line

  printf "  \033[1;32m%-24s\033[0m \033[1;36m%-19s\033[0m %-10s %s\n", name, addr, trans, cod
}
'
echo -e "${C_CYAN}===============================================================================${C_RESET}"
