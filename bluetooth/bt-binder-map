#!/data/data/com.termux/files/usr/bin/bash
#
# hard-tools: bluetooth/bt-binder-map
# Android Bluetooth Binder API & Transaction Code Enumerator
#

set -e

C_RESET="\033[0m"
C_BOLD="\033[1m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_CYAN="\033[1;36m"
C_MAGENTA="\033[1;35m"
C_DIM="\033[2m"

SERVICE="${1:-bluetooth_manager}"
MAX_TXN="${2:-35}"

run_root() {
    if [[ $EUID -eq 0 ]]; then
        "$@"
    elif command -v su >/dev/null 2>&1; then
        su -c "$*"
    else
        "$@"
    fi
}

echo -e "${C_CYAN}===============================================================================${C_RESET}"
echo -e "${C_BOLD} Binder Service Transaction Mapper : \033[1;32m${SERVICE}\033[0m${C_RESET}"
echo -e "${C_CYAN}===============================================================================${C_RESET}"
printf "  ${C_BOLD}%-8s %-18s %-20s %s${C_RESET}\n" "TXN CODE" "STATUS" "CLASSIFICATION" "RAW PARCEL / RETURN VALUE"
echo -e "  -----------------------------------------------------------------------------"

for i in $(seq 1 "$MAX_TXN"); do
    res=$(run_root "service call $SERVICE $i" 2>&1 || true)
    
    if [[ "$res" =~ "Not a data message" || "$res" =~ "UNKNOWN_TRANSACTION" ]]; then
        continue
    elif [[ "$res" =~ "Result: Parcel" ]]; then
        # Check if contains Binder token object
        if [[ "$res" =~ "Object #" || "$res" =~ "sh*" ]]; then
            printf "  \033[1;36mTXN %02d\033[0m   \033[1;32mSUCCESS (0x00)\033[0m    \033[1;35mBINDER_OBJECT\033[0m       \033[2mActive Interface Reference\033[0m\n" "$i"
        elif [[ "$res" =~ 00000000[[:space:]]+([0-9a-fA-F]{8}) ]]; then
            val="${BASH_REMATCH[1]}"
            desc="Value: $val"
            [[ "$val" == "0000000c" ]] && desc="0x0c (STATE_ON)"
            [[ "$val" == "0000000a" ]] && desc="0x0a (STATE_OFF)"
            [[ "$val" == "00000001" ]] && desc="0x01 (Boolean TRUE)"
            [[ "$val" == "00000000" ]] && desc="0x00 (Boolean FALSE / ZERO)"
            printf "  \033[1;36mTXN %02d\033[0m   \033[1;32mSUCCESS (0x00)\033[0m    \033[1;32mINTEGER / BOOL\033[0m      %s\n" "$i" "$desc"
        else
            # Parcel exception or other return
            printf "  \033[1;36mTXN %02d\033[0m   \033[1;33mPARCEL_DATA\033[0m       \033[2mCOMPLEX_PARCEL\033[0m      \033[2mRequires Arguments\033[0m\n" "$i"
        fi
    elif [[ "$res" =~ "Permission Denial" ]]; then
        printf "  \033[1;36mTXN %02d\033[0m   \033[1;31mPERMISSION_DENIED\033[0m \033[1;31mSECURITY_CHECK\033[0m      \033[2mRequires System Signature\033[0m\n" "$i"
    fi
done

echo -e "${C_CYAN}===============================================================================${C_RESET}"
